@using Microsoft.IdentityModel.Tokens

@model List<DevConnect.Models.TbPublicacao>



<script defer>

        const usuarioPublicacao = "@ViewBag.UsuarioPublicacao"

        if(usuarioPublicacao == "Nao Cadastrada"){
            alert("Usuário não cadastrado! Tente Novamente...")
        }

        else if(usuarioPublicacao == "Cadastrada"){
             alert("Publicação postada...😁");
        }
</script>

